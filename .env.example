# Qwen3.8 Trading Engine - Environment Variables
# Copy this file to .env.local and fill in your API keys

# ============================================================================
# Market Data Provider (Optional - app works with mock data if not set)
# ============================================================================

# Polygon.io API Key (for real market data)
# POLYGON_API_KEY=your_polygon_api_key_here

# Alpaca Markets API Keys (alternative provider)
# ALPACA_API_KEY=your_alpaca_api_key_here
# ALPACA_API_SECRET=your_alpaca_api_secret_here

# ============================================================================
# News & Sentiment Provider (Optional)
# ============================================================================

# Financial Modeling Prep API Key
# FMP_API_KEY=your_fmp_api_key_here

# NewsAPI.org Key
# NEWS_API_KEY=your_newsapi_key_here

# ============================================================================
# App Configuration
# ============================================================================

# Default risk settings (used by mock provider)
DEFAULT_ACCOUNT_EQUITY=100000
DEFAULT_RISK_PER_TRADE=1.0
DEFAULT_MAX_DAILY_LOSS=3.0
DEFAULT_MAX_POSITIONS=5

# Server
PORT=3000
NODE_ENV=development
